/* Full-bleed wizard styled against the terminal's own ANSI palette.
   Hierarchy comes from bold / dim / reverse + borders, not bespoke hex. */

Screen {
    align: left top;
}

/* ---- Wizard frame: left step rail + content column ---- */
.wizard-frame {
    height: 1fr;
}

.step-rail {
    width: 24;
    height: 1fr;
    border-right: vkey $primary;
    padding: 1 2;
}

.rail-title {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 1;
}

.rail-current {
    text-style: bold reverse;
    margin-bottom: 1;
}

.rail-visited {
    margin-bottom: 1;
}

.rail-visited:hover {
    text-style: underline;
}

.rail-future {
    color: $text-muted;
    text-style: dim;
    margin-bottom: 1;
}

.wizard-content {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.content-title {
    text-style: bold underline;
    margin-bottom: 1;
}

.card-body {
    height: 1fr;
}

.section-label {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.hint {
    color: $text-muted;
}

.wizard-status {
    height: auto;
    color: $error;
    text-style: bold;
    margin-top: 1;
}

.nav-row {
    height: auto;
    align: right middle;
    margin-top: 1;
}

.nav-row Button {
    margin-left: 2;
}

Input, Select, TextArea {
    margin-bottom: 1;
}

/* ---- Sources step ---- */
#location {
    margin-bottom: 1;
}

#picker {
    height: 13;
    margin-bottom: 1;
}

#browser {
    width: 3fr;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    margin-right: 1;
}

#chosen {
    width: 2fr;
    height: 100%;
    border: round $accent;
    border-title-align: left;
    border-title-color: $accent;
}

#sources_actions {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#sources_actions Button {
    margin-right: 2;
}

#custom_instructions {
    height: 8;
}

RadioSet {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#review_summary {
    height: auto;
}

/* ---- Generation screen ---- */
.gen-content {
    height: 1fr;
    padding: 1 2;
}

#gen_title {
    text-style: bold;
    margin-bottom: 1;
}

PhaseChecklist {
    height: auto;
    margin-bottom: 1;
}

#gen_bar {
    width: 100%;
    margin-bottom: 0;
}

#round_label {
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

#round_bar {
    width: 100%;
    margin-bottom: 1;
}

#live_panel {
    height: 12;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    margin-bottom: 1;
}

#live_text {
    height: auto;
    padding: 0 1;
}

#gen_log {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#gen_nav {
    height: auto;
    align: right middle;
    margin-top: 1;
}

#gen_nav Button {
    margin-left: 2;
}
